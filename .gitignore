# dependencies
node_modules/
functions/node_modules/

# next.js
.next/
out/
build/

# environment — never commit real keys, tokens, or service credentials.
# .env.local carries SUPABASE_SERVICE_ROLE_KEY, which bypasses Row Level
# Security entirely.
.env
.env.local
.env*.local

# MCP server config — may carry a Supabase personal access token.
# Commit .mcp.json.example instead, with ${ENV_VAR} placeholders.
.mcp.json

# supabase — machine-local link state, regenerated by `supabase link`.
#
# Leading `**/` on purpose: a pattern containing a slash is anchored to the
# directory holding the .gitignore, so the previous `supabase/.temp/` only ever
# matched a root-level supabase/, and the real one at app/supabase/.temp/ was
# tracked the whole time. That went unnoticed until `npm run env:test` started
# rewriting project-ref, linked-project.json and pooler-url on every switch,
# which put machine state in every diff.
**/supabase/.temp/
**/supabase/.branches/

# android / capacitor — app/android has its own .gitignore for build output;
# these are the machine-specific bits that sit outside it.
app/android/local.properties
app/android/.gradle/
*.keystore
*.jks

# vercel
.vercel

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-error.log*
.vscode/
.idea/
