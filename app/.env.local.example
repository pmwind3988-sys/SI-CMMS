# Copy this file to .env.local and fill in your Firebase project's web app config
# (Firebase Console → Project Settings → General → Your apps → SDK setup and configuration)

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional — only needed if you run against the local Firebase Emulator Suite
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Optional — restricts sign-in to this email domain (e.g. "acmecorp.com").
# Leave blank during development to allow any email domain.
NEXT_PUBLIC_COMPANY_EMAIL_DOMAIN=
