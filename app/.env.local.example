# Copy this file to .env.local and fill in your Supabase project's values
# (Supabase Dashboard → Project Settings → API)

# The REST/Realtime endpoint, e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The publishable ("anon") key. Safe to expose and safe to commit to Vercel's
# env vars: it carries no authority of its own — every request it makes is
# evaluated against Row Level Security using the signed-in user's JWT, exactly
# as the Firebase web API key was evaluated against security rules.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY — never prefix this with NEXT_PUBLIC_, never commit it, and
# never set it in Vercel. The service role key bypasses Row Level Security
# entirely. It is read only by the Node scripts in scripts/, which run on your
# machine: seedDatabase.js, bootstrapUsers.js, recordApkBuild.js.
# Supabase Dashboard → Project Settings → API → service_role (click to reveal).
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# Optional — restricts sign-in to this email domain (e.g. "acmecorp.com").
# Leave blank during development to allow any email domain.
NEXT_PUBLIC_COMPANY_EMAIL_DOMAIN=

# The public web origin, e.g. https://si.vercel.app — no trailing slash.
#
# Only password-reset links use it, and only because window.location.origin is
# wrong in one place that matters: Capacitor serves the same static export from
# https://localhost, so a link built from the running origin points the user's
# mail client at their own phone. Set this for the APK build. On the web build
# it is optional — the origin is already correct there — but setting it costs
# nothing and makes the two builds behave identically.
#
# Whatever is set here must also be listed in the Supabase dashboard under
# Authentication → URL Configuration → Redirect URLs, including the
# /reset-password/ path, or Supabase refuses the redirect and the link dies
# before it reaches the app.
NEXT_PUBLIC_SITE_URL=

# The public half of this project's Web Push VAPID keypair — an 87-character
# base64url string, printed by `npm run keys:vapid` alongside the Edge
# Function secrets it also generates. Baked into the client bundle at build
# time; pushSupported() silently returns false without it, so the alerts gate
# still appears, the user still grants OS notification permission, and no
# device is ever registered — nothing errors, the feature is just quietly
# inert. This exact mistake already happened once during this feature's own
# development (see the CORRECTION entry in
# .superpowers/sdd/2026-08-27-web-push/progress.md), which is why it is
# listed here now instead of only in the generator's own printout.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
