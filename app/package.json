{
  "name": "si-work-order-module",
  "version": "1.0.0",
  "private": true,
  "description": "SI (Service Inside) — Work Order Management module. React + Next.js + Supabase, hosted on Vercel.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "db:types": "supabase gen types typescript --linked > src/lib/database.types.ts",
    "check:env": "node scripts/checkEnv.js",
    "seed:demo": "node scripts/seedDemoWorkOrder.js",
    "bootstrap:users": "node scripts/bootstrapUsers.js",
    "apk:record": "node scripts/recordApkBuild.js",
    "cap:sync": "cap sync android",
    "apk": "npm run build && cap sync android && npm run apk:debug",
    "apk:debug": "cd android && .\\gradlew.bat assembleDebug",
    "apk:release": "cd android && .\\gradlew.bat assembleRelease",
    "icons": "node scripts/generateIcons.js"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/local-notifications": "^6.1.3",
    "@supabase/supabase-js": "^2.112.2",
    "lucide-react": "^0.383.0",
    "next": "^16.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "supabase": "^2.111.0",
    "tailwindcss": "^3.4.4"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
