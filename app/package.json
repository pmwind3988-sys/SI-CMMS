{
  "name": "si-work-order-module",
  "version": "1.0.0",
  "private": true,
  "description": "SI (Service Inside) — Work Order Management module. React + Next.js + Firebase.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "emulators": "firebase emulators:start --only firestore,auth,functions",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "seed:demo": "node scripts/seedDemoWorkOrder.js",
    "seed:db": "node scripts/seedDatabase.js",
    "bootstrap:users": "node scripts/bootstrapUsers.js",
    "apk:record": "node scripts/recordApkBuild.js",
    "schema:check": "node scripts/checkSchema.js",
    "cap:sync": "cap sync android",
    "apk": "npm run build && cap sync android && npm run apk:debug",
    "apk:debug": "cd android && .\\gradlew.bat assembleDebug",
    "apk:release": "cd android && .\\gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "firebase": "^10.12.2",
    "lucide-react": "^0.383.0",
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "autoprefixer": "^10.4.19",
    "firebase-admin": "^14.2.0",
    "firebase-tools": "^15.25.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
